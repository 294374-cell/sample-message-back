APP_NAME=Mensagens
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# URL pública (do ponto de vista do navegador, atrás do nginx).
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Banco de dados (Postgres) ---
# Em Docker, DB_HOST deve ser o nome do serviço no compose (ex.: postgres).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mensagens
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Cache e Sessão ---
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# --- Fila ---
# Aqui está o coração do trabalho: a fila roda em cima do Redis.
# O worker (php artisan queue:work) consome dela.
QUEUE_CONNECTION=redis

# --- Redis ---
# Em Docker, REDIS_HOST deve ser o nome do serviço no compose (ex.: redis).
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Proxy ---
# Em produção, o backend fica ATRÁS do nginx. Confie nos headers
# X-Forwarded-* que o nginx envia (já configurados em frontend/nginx.conf).
TRUSTED_PROXIES=*
